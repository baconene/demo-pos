# DEMO POS — template only. Configure actual secrets in Laravel Forge.
APP_NAME="DEMO POS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://demo-pos.baconologies.com
APP_TIMEZONE=Asia/Manila
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=demo_pos
DB_USERNAME=demo_pos
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# POS order default and conditional requirements are compiled in the
# client-specific application code, not controlled by an inert .env switch.
# The stage script applies dine_in and the agreed field matrix consistently.

# Real-time cloud printing. Use an isolated client Pusher application.
BROADCAST_CONNECTION=log
# Switch to pusher after configuring isolated client credentials and print service.
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=ap1
PUSHER_BEAMS_INSTANCE_ID=
PUSHER_BEAMS_SECRET_KEY=

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"